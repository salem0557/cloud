# انسخ هذا الملف إلى ‎.env وضع توكن البوت الخاص بك (من @BotFather)
TELEGRAM_BOT_TOKEN=123456789:AAAA-your-token-here

# --- الاشتراك المدفوع ---
# معرّف محادثتك أنت في تيليجرام (المشرف — دائم الصلاحية ويملك أوامر /approve /revoke /subs)
ADMIN_CHAT_ID=123456789
# طريقة التواصل التي تظهر للراغبين بالاشتراك
SUBSCRIBE_CONTACT=@your_username
# مدة الاشتراك الافتراضية بالأيام عند /approve بدون تحديد
DEFAULT_SUB_DAYS=30

# --- "وجهة نظر البوت" (ملخص أخبار + StockTwits لكل سهم مُرشَّح) ---
# مجاني: 1) افتح aistudio.google.com وسجّل دخول بحساب Google
#        2) اضغط "Get API key" وأنشئ مفتاحاً جديداً (بلا بطاقة ائتمان)
#        3) الصقه هنا. بدون هذا المفتاح يُعطَّل القسم تلقائياً بلا أي خطأ.
GEMINI_API_KEY=

# --- /bottomcalls: عقود CALL على أسهم في قاع اعتادت الارتداد (اختياري) ---
# BOTTOM_MAX_PREMIUM=3        # أقصى بريميوم بالدولار للسهم الواحد (عقد <= 300$)
# BOTTOM_MIN_DTE=30           # أقل مدة للعقد بالأيام
# BOTTOM_MAX_DTE=365          # أقصى مدة للعقد بالأيام
# DIP_RSI=35                  # RSI يومي يعتبر "منطقة قاع"
# DIP_NEAR_LOW_PCT=0.10       # أو الإغلاق ضمن 10% فوق قاع 52 أسبوع
# REBOUND_MIN_GAIN=0.08       # الارتداد المطلوب تاريخياً (8%)
# REBOUND_MIN_RATE=0.60       # نسبة نجاح الارتداد التاريخية المطلوبة
# REBOUND_MIN_EPISODES=3      # أقل عدد مرات تاريخية مشابهة

# اختياري: تغيير الإعدادات الافتراضية
# FILTERS_REQUIRED=3        # عدد الفلاتر المطلوبة من أصل 4
# SCAN_INTERVAL=1h          # فريم الشموع
# MIN_PRICE=2               # استبعاد الأسهم تحت هذا السعر بالدولار
# MIN_AVG_VOLUME=30000      # استبعاد الأسهم قليلة السيولة
# RSI_OVERSOLD=30

# =====================================================================
# محلل التشارت (analyst_agent) — يوزر بوت تلقرام + Groq
# =====================================================================
# 1) مفتاح Groq (مجاني): console.groq.com/keys
GROQ_API_KEY=
# اختياري: تثبيت موديل معيّن. إن تُرك فارغاً يختار الوكيل أفضل موديل متاح تلقائياً
# GROQ_TEXT_MODEL=
# GROQ_VISION_MODEL=

# 2) طريقة التشغيل — اختر واحدة:

# (أ) الأسهل: بوت من @BotFather — لا يحتاج تسجيل دخول ولا جهاز
#     أنشئ بوتاً جديداً (لا تستخدم توكن بوت الماسح)، والصق التوكن هنا:
#     ثم في @BotFather: /setprivacy ← اختر البوت ← Disable  (ليقرأ كلمة «حلل» في القروب)
#     التشغيل: python -m analyst_agent.telebot
ANALYST_BOT_TOKEN=

# (ب) يوزر بوت (حساب حقيقي): api_id و api_hash من my.telegram.org ثم
#     python -m analyst_agent.login   وضع الناتج في TELEGRAM_SESSION
#     التشغيل: python -m analyst_agent.userbot
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION=

# 3) أين يرد الوكيل (اختياري)
# ANALYST_ALLOWED_CHATS=-1001234567890   # فارغ = كل القروبات التي فيها الحساب
# --- قروب توبيكات (Topics): أرسل /here داخل كل قسم ليعطيك رقمه ---
# ANALYST_QA_TOPIC=1773                  # القسم الوحيد الذي يجاوب فيه
# ANALYST_ALERTS_TOPIC=1                 # قسم التوصيات (لأمر /post)
# ANALYST_BLOCKED_CHATS=
# ANALYST_OWNER_IDS=123456789            # معرّفك: بلا فترة انتظار بين الطلبات
# ANALYST_TRIGGERS=تحليل,حلل,شارت,analyze # الكلمات التي تنبّه الوكيل في القروب
# ANALYST_ANSWER_ALL_PHOTOS=true         # أي صورة تشارت تُحلَّل مع أي نص (الافتراضي)
# ANALYST_DM_ALWAYS=true                 # في المحادثة الخاصة يحلل كل تشارت
# ANALYST_USER_COOLDOWN=20               # ثوانٍ بين طلبات المستخدم نفسه
# ANALYST_MAX_CONCURRENT=2
# ANALYST_STARTUP_CHECK=true             # طباعة تقرير الفحص في السجلّات عند التشغيل

# 4) التوصيات التلقائية في قسم التوصيات
# ANALYST_ALERTS_CHAT=-1001234567890     # رقم القروب (خذه بأمر /here) — مطلوب للتشغيل
# ANALYST_ALERTS_TOPIC=1                 # قسم التوصيات
# ANALYST_WATCH=true                     # تشغيل/إيقاف
# ANALYST_WATCH_FRAME=1h                 # فريم المسح
# ANALYST_WATCH_INTERVAL=30              # كل كم دقيقة يمسح
# ANALYST_WATCHLIST=NVDA,TSLA,AAPL,BTC-USD   # فارغ = القائمة الافتراضية (43 رمزاً)
# --- الشروط التي يجب أن يحققها السهم ---
# ANALYST_WATCH_MIN_CONVICTION=65        # أقل ثقة
# ANALYST_WATCH_MIN_SCORE=40             # أقل قوة إشارة
# ANALYST_WATCH_MIN_RR=1.5               # أقل عائد/مخاطرة
# ANALYST_WATCH_MIN_ADX=18               # اتجاه فعّال
# ANALYST_WATCH_MIN_REL_VOLUME=0.9       # فوليوم مقارنة بالمعدل
# ANALYST_WATCH_SIDES=long               # long | short | both
# ANALYST_WATCH_MAX_PER_RUN=3            # أقصى توصيات في الدورة
# ANALYST_WATCH_MAX_PER_DAY=10           # أقصى توصيات في اليوم
# ANALYST_WATCH_COOLDOWN_HOURS=12        # لا يعيد نفس السهم قبل هذه المدة
# ANALYST_WATCH_SKIP_EARNINGS_DAYS=3     # يتجاهل سهماً نتائجه قريبة
# ANALYST_WATCH_ONLY_WHEN_OPEN=true      # لا ينشر والسوق مغلق (الكريبتو دائماً مفتوح)

# 5) التحليل (اختياري)
# ANALYST_US_ONLY=true                   # السوق الأمريكي فقط (الافتراضي)
# ANALYST_ALLOW_NON_EQUITY=true          # السماح بالبيتكوين والذهب والعملات
# ANALYST_DEFAULT_FRAME=1d               # الفريم إن لم يُذكر ولم يظهر في الصورة
# ANALYST_CHART_BARS=140                 # عدد الشموع في التشارت الناتج
# ANALYST_NEWS=true                      # عناوين ياهو
# ANALYST_SOCIAL=true                    # مزاج StockTwits
# ANALYST_CHART_STYLE=nightclouds
