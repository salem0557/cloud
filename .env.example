#  بوت تنبيهات القيعان والقمم (alerts_bot.py)
# ==========================================================================
# توكن البوت من @BotFather (أو اتركه ليستخدم TELEGRAM_BOT_TOKEN أعلاه)
ALERTS_BOT_TOKEN=

