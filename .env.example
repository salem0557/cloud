# انسخ هذا الملف إلى ‎.env وضع توكن البوت الخاص بك (من @BotFather)
TELEGRAM_BOT_TOKEN=123456789:AAAA-your-token-here

# --- الاشتراك المدفوع ---
# معرّف محادثتك أنت في تيليجرام (المشرف — دائم الصلاحية ويملك أوامر /approve /revoke /subs)
ADMIN_CHAT_ID=123456789
# طريقة التواصل التي تظهر للراغبين بالاشتراك
SUBSCRIBE_CONTACT=@your_username
# مدة الاشتراك الافتراضية بالأيام عند /approve بدون تحديد
DEFAULT_SUB_DAYS=30

# --- "وجهة نظر البوت" (ملخص أخبار + StockTwits لكل سهم مُرشَّح) ---
# مجاني: 1) افتح aistudio.google.com وسجّل دخول بحساب Google
#        2) اضغط "Get API key" وأنشئ مفتاحاً جديداً (بلا بطاقة ائتمان)
#        3) الصقه هنا. بدون هذا المفتاح يُعطَّل القسم تلقائياً بلا أي خطأ.
GEMINI_API_KEY=

# --- /bottomcalls: عقود CALL على أسهم في قاع اعتادت الارتداد (اختياري) ---
# BOTTOM_MAX_PREMIUM=3        # أقصى بريميوم بالدولار للسهم الواحد (عقد <= 300$)
# BOTTOM_MIN_DTE=30           # أقل مدة للعقد بالأيام
# BOTTOM_MAX_DTE=365          # أقصى مدة للعقد بالأيام
# DIP_RSI=35                  # RSI يومي يعتبر "منطقة قاع"
# DIP_NEAR_LOW_PCT=0.10       # أو الإغلاق ضمن 10% فوق قاع 52 أسبوع
# REBOUND_MIN_GAIN=0.08       # الارتداد المطلوب تاريخياً (8%)
# REBOUND_MIN_RATE=0.60       # نسبة نجاح الارتداد التاريخية المطلوبة
# REBOUND_MIN_EPISODES=3      # أقل عدد مرات تاريخية مشابهة

# اختياري: تغيير الإعدادات الافتراضية
# FILTERS_REQUIRED=3        # عدد الفلاتر المطلوبة من أصل 4
# SCAN_INTERVAL=1h          # فريم الشموع
# MIN_PRICE=2               # استبعاد الأسهم تحت هذا السعر بالدولار
# MIN_AVG_VOLUME=30000      # استبعاد الأسهم قليلة السيولة
# RSI_OVERSOLD=30


# ==========================================================================
#  بوت العملات الرقمية (crypto_bot.py) — محلل + متداول
# ==========================================================================
# توكن منفصل للبوت (أو اتركه ليستخدم TELEGRAM_BOT_TOKEN أعلاه)
CRYPTO_BOT_TOKEN=
# معرّف محادثتك — بدونه تُقفل كل أوامر التداول
CRYPTO_ADMIN_CHAT_ID=

# --- ربط المحفظة (مفاتيح API فقط — لا تضع أبداً العبارة السرية seed phrase) ---
# أنشئ المفتاح من إعدادات المنصة، وفعّل صلاحية "التداول" فقط،
# واترك صلاحية "السحب" مغلقة، وقيّده بعنوان IP إن أمكن.
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSWORD=          # لمنصات okx / kucoin فقط
EXCHANGE_MARKET_TYPE=spot       # spot أو swap (العقود)
EXCHANGE_TESTNET=0              # 1 لاستخدام حساب تجريبي على المنصة

# --- قفل التداول الحقيقي (مفتاحان لا بد أن يتفقا) ---
# بدونهما البوت يعمل بوضع تجريبي كامل على أسعار حقيقية.
# جرّب أسبوعاً على الأقل بالوضع التجريبي وراجع /pnl قبل التفعيل.
CRYPTO_LIVE_TRADING=0
CRYPTO_LIVE_CONFIRM=            # اكتب: I_UNDERSTAND_THE_RISK

# --- العملات والفريمات ---
CRYPTO_QUOTE=USDT
CRYPTO_WATCHLIST=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT
# CRYPTO_AUTO_TOP_N=0           # أضف تلقائياً أعلى N عملة سيولة
# CRYPTO_LTF=5m                 # فريم الدخول
# CRYPTO_HTF=1h                 # فريم الاتجاه
# CRYPTO_LOOP_SECONDS=30        # كل كم ثانية يفحص

# --- شروط المحلل (رفع القيم = صفقات أقل وأدق) ---
# CRYPTO_MIN_SCORE=70           # أقل قوة مقبولة من 100
# CRYPTO_MIN_RR=1.5             # أقل عائد/مخاطرة بعد الرسوم
# CRYPTO_MIN_ATR_PCT=0.15       # أقل تذبذب مقبول
# CRYPTO_MAX_ATR_PCT=3.0        # أقصى تذبذب مقبول
# CRYPTO_MAX_SPREAD_PCT=0.08    # أقصى فارق بين العرض والطلب
# CRYPTO_MIN_24H_VOLUME=20000000
# CRYPTO_ALLOW_SHORT=0          # يتطلب EXCHANGE_MARKET_TYPE=swap

# --- إدارة المخاطر ---
# CRYPTO_RISK_PER_TRADE_PCT=0.5 # نسبة الرصيد المعرّضة للخسارة في كل صفقة
# CRYPTO_MAX_POSITION_PCT=25    # أقصى حجم مركز واحد من الرصيد
# CRYPTO_MAX_OPEN_POSITIONS=3
# CRYPTO_MAX_TRADES_PER_DAY=20
# CRYPTO_DAILY_MAX_LOSS_PCT=3   # عند بلوغها يتوقف الدخول لبقية اليوم
# CRYPTO_SYMBOL_COOLDOWN_MIN=30 # تهدئة على العملة بعد صفقة خاسرة
# CRYPTO_MIN_ORDER_USD=10
# CRYPTO_LEVERAGE=1             # للعقود فقط — ارفعها على مسؤوليتك

# --- خطة الخروج ---
# CRYPTO_SL_ATR_MULT=1.2        # مسافة الوقف بوحدات ATR
# CRYPTO_TP1_R=1.0              # الهدف الأول بمضاعفات المخاطرة
# CRYPTO_TP2_R=2.0
# CRYPTO_TP1_FRACTION=0.5       # النسبة المباعة عند الهدف الأول
# CRYPTO_TRAIL_ATR_MULT=1.0     # الوقف المتحرك بعد الهدف الأول
# CRYPTO_MAX_HOLD_MINUTES=90    # أقصى مدة للصفقة الواحدة
# CRYPTO_STALE_EXIT_R=0.3

# --- الوضع التجريبي ---
# CRYPTO_PAPER_BALANCE=1000     # رصيد وهمي للاختبار
# CRYPTO_TAKER_FEE_PCT=0.1      # رسوم المنصة لكل جهة
# CRYPTO_SLIPPAGE_PCT=0.05      # انزلاق مفترض


